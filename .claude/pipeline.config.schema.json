{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PMDevSolutions/Marketing/blob/main/.claude/pipeline.config.schema.json",
  "title": "Maecenas Pipeline Configuration",
  "description": "Schema for .claude/pipeline.config.json — controls brand-voice enforcement, editorial QA thresholds, the human approval gate, asset-type definitions, and orchestration for the autonomous campaign pipeline.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON Schema URI for IDE validation and autocompletion."
    },
    "description": { "type": "string" },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of the config schema in use."
    },

    "brandVoice": {
      "type": "object",
      "additionalProperties": false,
      "description": "Brand lockfile enforcement — the marketing analog of design-token verification.",
      "properties": {
        "enforced": { "type": "boolean", "description": "Master switch for brand-voice enforcement in editorial QA." },
        "lockfile": { "type": "string", "description": "Path to brand-guidelines.json, the single source of truth." },
        "requireLockfileBeforeDrafting": { "type": "boolean", "description": "Hard gate: drafting phases refuse to start without a lockfile." },
        "lintBlocking": { "type": "boolean", "description": "brand-voice-lint.js findings block (true) or warn (false)." },
        "bannedWordsPolicy": { "enum": ["block", "warn"], "description": "Treatment of lexicon.banned hits." },
        "driftCheck": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "autoCheck": { "type": "boolean", "description": "Run the Phase 0 drift check when a lockfile exists." },
            "warnOnDrift": { "type": "boolean", "description": "Surface drift between lockfile and recent assets." }
          }
        }
      }
    },

    "readability": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-asset-type readability targets checked by readability-score.js.",
      "properties": {
        "blocking": { "type": "boolean", "description": "Below-target readability blocks (true) or warns (false)." },
        "targets": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/readabilityTarget" },
          "description": "Map of assetType → readability target. Keys should match /assetTypes."
        }
      }
    },

    "editorialLoop": {
      "type": "object",
      "additionalProperties": false,
      "description": "Bounded revision loop — the analog of the old visual-diff iteration loop.",
      "properties": {
        "maxRevisions": { "type": "integer", "minimum": 1, "description": "Max QA→revise iterations per asset before escalation." },
        "maxFixAttemptsPerFinding": { "type": "integer", "minimum": 1, "description": "Max fix attempts per finding within one iteration." },
        "stopOnFirstPass": { "type": "boolean", "description": "End the loop the first time all checks pass." },
        "escalateOnExhaustion": { "type": "boolean", "description": "Escalate to the user (never silently ship) when the loop is exhausted." }
      }
    },

    "factCheck": {
      "type": "object",
      "additionalProperties": false,
      "description": "Claim verification policy. Fabrication is never waivable below the approval gate.",
      "properties": {
        "required": { "type": "boolean" },
        "blocking": { "type": "boolean" },
        "citationRequiredForStatistics": { "type": "boolean", "description": "Every statistic carries a dated, linked source." },
        "superlativesRequireSubstantiation": { "type": "boolean" },
        "testimonialPolicy": { "type": "string", "description": "e.g. real-permissioned-documented." },
        "fabricationPolicy": { "const": "block", "description": "Fabricated claims always block. Not configurable to anything weaker." },
        "unverifiableClaimPolicy": { "enum": ["reword-or-cut", "block"], "description": "Treatment of claims that cannot be verified." }
      }
    },

    "seoChecklist": {
      "type": "object",
      "additionalProperties": false,
      "description": "On-page checks applied to web-bound assets by seo-check.js.",
      "properties": {
        "blocking": { "type": "boolean" },
        "titleMaxChars": { "type": "integer", "minimum": 1 },
        "metaDescriptionMaxChars": { "type": "integer", "minimum": 1 },
        "requireKeywordInTitle": { "type": "boolean" },
        "requireKeywordInH1": { "type": "boolean" },
        "minInternalLinks": { "type": "integer", "minimum": 0 },
        "minCitedSources": { "type": "integer", "minimum": 0 },
        "enforceHeadingHierarchy": { "type": "boolean" }
      }
    },

    "humanApproval": {
      "type": "object",
      "additionalProperties": false,
      "description": "The hard gate before anything external. The analog of tdd.enforced — non-negotiable.",
      "properties": {
        "required": { "const": true, "description": "Always true. The gate cannot be disabled." },
        "blocking": { "const": true, "description": "Always true. Un-approved assets are withheld." },
        "nonNegotiable": { "const": true },
        "perAsset": { "type": "boolean", "description": "Approval granted per asset (true) or per package (false)." },
        "scope": {
          "type": "array",
          "items": { "enum": ["publish", "send", "spend", "schedule"] },
          "minItems": 1,
          "description": "Actions that require explicit human approval."
        },
        "autoApprove": { "const": false, "description": "Always false. No timeout- or default-approval exists." },
        "waiverLogging": { "type": "boolean", "description": "WARN-level waivers granted at the gate are logged." },
        "packageFile": { "type": "string", "description": "Filename of the assembled approval package." }
      }
    },

    "assetTypes": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/assetType" },
      "description": "Asset-type definitions — the analog of the old appTypes. Keys are assetType slugs."
    },

    "calendar": {
      "type": "object",
      "additionalProperties": false,
      "description": "Scheduling rules enforced by validate-content-calendar.js.",
      "properties": {
        "file": { "type": "string" },
        "leadTimes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "draftToQaDays": { "type": "integer", "minimum": 0 },
            "qaToApprovalDays": { "type": "integer", "minimum": 0 },
            "approvalToPublishDays": { "type": "integer", "minimum": 1, "description": "Approvals are not compressible below one business day." }
          }
        },
        "cadenceDefaults": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "perWeek": { "type": "integer", "minimum": 0 },
              "maxPerDay": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "staleStatusDays": { "type": "integer", "minimum": 1, "description": "Days an entry may sit in one status before the validator flags it." }
      }
    },

    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "utmRequired": { "type": "boolean" },
        "utmCampaignPattern": { "type": "string" },
        "utmContentPattern": { "type": "string" },
        "baselineRequired": { "type": "boolean", "description": "No campaign launches without recorded baselines." },
        "reportSchedule": { "type": "array", "items": { "type": "string" } },
        "doubleCountingAudit": { "type": "string", "description": "Cadence of the platform-claims vs actuals reconciliation." }
      }
    },

    "compliance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "regulatedTopics": { "type": "array", "items": { "type": "string" } },
        "legalReviewTriggers": { "type": "array", "items": { "type": "string" } },
        "disclosureRules": { "type": "array", "items": { "type": "string" } }
      }
    },

    "campaignCadence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cycleWeeks": { "type": "integer", "minimum": 1 },
        "structure": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    },

    "orchestration": {
      "type": "object",
      "additionalProperties": false,
      "description": "Parallel phase execution — dependency graph consumed by the parallel-orchestration skill.",
      "properties": {
        "enabled": { "type": "boolean" },
        "maxConcurrent": { "type": "integer", "minimum": 1 },
        "phases": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/phase" }
        },
        "reporting": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "showStreamingResults": { "type": "boolean" },
            "showBatchSummary": { "type": "boolean" },
            "showSpeedupEstimate": { "type": "boolean" },
            "includeTimeline": { "type": "boolean" }
          }
        }
      }
    },

    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outputDir": { "type": "string" },
        "campaignReportFile": { "type": "string" },
        "qaReportFile": { "type": "string" },
        "approvalPackageFile": { "type": "string" },
        "includeQaEvidence": { "type": "boolean" }
      }
    }
  },

  "$defs": {
    "readabilityTarget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fleschMin": { "type": "number", "minimum": 0, "maximum": 100, "description": "Minimum Flesch Reading Ease score." },
        "maxAvgSentenceWords": { "type": "number", "minimum": 1 },
        "maxPassiveVoicePct": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    },
    "assetType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "ownerAgent", "qaChecks", "approvalScope"],
      "properties": {
        "description": { "type": "string" },
        "ownerAgent": { "type": "string", "description": "Agent name from .claude/agents/ that owns drafting." },
        "draftSkill": { "type": ["string", "null"], "description": "Skill from .claude/skills/ used for drafting, if any." },
        "qaChecks": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1,
          "description": "Checks the editorial-qa skill runs for this asset type."
        },
        "approvalScope": {
          "type": "array",
          "items": { "enum": ["publish", "send", "spend", "schedule"] },
          "minItems": 1,
          "description": "Which gated actions this asset type performs when it goes live."
        },
        "complianceElements": { "type": "array", "items": { "type": "string" } },
        "embargoIntegrity": { "type": "boolean" },
        "spendGovernance": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "killCriteriaRequired": { "type": "boolean" },
            "pacingCheck": { "type": "string" },
            "scaleUpRequiresApproval": { "type": "boolean" }
          }
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["depends", "blocking", "description"],
      "properties": {
        "depends": { "type": "array", "items": { "type": "string" } },
        "resources": {
          "type": "array",
          "items": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["name", "mode"],
                "properties": {
                  "name": { "type": "string" },
                  "mode": { "enum": ["exclusive", "shared"] }
                }
              }
            ]
          }
        },
        "blocking": { "type": "boolean" },
        "humanGate": { "type": "boolean", "description": "Phase requires explicit human action; the scheduler never auto-passes it." },
        "perAsset": { "type": "boolean", "description": "Phase fans out into per-asset lanes." },
        "description": { "type": "string" }
      }
    }
  }
}
