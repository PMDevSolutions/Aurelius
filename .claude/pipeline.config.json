{
  "$schema": "./pipeline.config.schema.json",
  "description": "Configuration for the brief-to-publish-ready autonomous campaign pipeline",
  "version": "2.0.0",
  "brandVoice": {
    "enforced": true,
    "lockfile": "brand-guidelines.json",
    "requireLockfileBeforeDrafting": true,
    "lintBlocking": true,
    "bannedWordsPolicy": "block",
    "driftCheck": {
      "autoCheck": true,
      "warnOnDrift": true
    }
  },
  "readability": {
    "blocking": false,
    "targets": {
      "blog-post":     { "fleschMin": 60, "maxAvgSentenceWords": 22, "maxPassiveVoicePct": 12 },
      "email":         { "fleschMin": 65, "maxAvgSentenceWords": 18, "maxPassiveVoicePct": 10 },
      "email-sequence":{ "fleschMin": 65, "maxAvgSentenceWords": 18, "maxPassiveVoicePct": 10 },
      "social-batch":  { "fleschMin": 70, "maxAvgSentenceWords": 14, "maxPassiveVoicePct": 8 },
      "ad-campaign":   { "fleschMin": 75, "maxAvgSentenceWords": 12, "maxPassiveVoicePct": 5 },
      "landing-page":  { "fleschMin": 65, "maxAvgSentenceWords": 16, "maxPassiveVoicePct": 8 },
      "press-release": { "fleschMin": 55, "maxAvgSentenceWords": 24, "maxPassiveVoicePct": 15 },
      "video-script":  { "fleschMin": 70, "maxAvgSentenceWords": 14, "maxPassiveVoicePct": 8 }
    }
  },
  "editorialLoop": {
    "maxRevisions": 5,
    "maxFixAttemptsPerFinding": 2,
    "stopOnFirstPass": true,
    "escalateOnExhaustion": true
  },
  "factCheck": {
    "required": true,
    "blocking": true,
    "citationRequiredForStatistics": true,
    "superlativesRequireSubstantiation": true,
    "testimonialPolicy": "real-permissioned-documented",
    "fabricationPolicy": "block",
    "unverifiableClaimPolicy": "reword-or-cut"
  },
  "seoChecklist": {
    "blocking": false,
    "titleMaxChars": 60,
    "metaDescriptionMaxChars": 155,
    "requireKeywordInTitle": true,
    "requireKeywordInH1": true,
    "minInternalLinks": 2,
    "minCitedSources": 1,
    "enforceHeadingHierarchy": true
  },
  "humanApproval": {
    "required": true,
    "blocking": true,
    "nonNegotiable": true,
    "perAsset": true,
    "scope": ["publish", "send", "spend", "schedule"],
    "autoApprove": false,
    "waiverLogging": true,
    "packageFile": "approval-package.md"
  },
  "assetTypes": {
    "blog-post": {
      "description": "Long-form article for the blog or guest placement",
      "ownerAgent": "blog-writer",
      "draftSkill": null,
      "qaChecks": ["brand-voice", "readability", "fact-check", "seo"],
      "approvalScope": ["publish"]
    },
    "email": {
      "description": "Single broadcast email or newsletter issue",
      "ownerAgent": "email-marketer",
      "draftSkill": null,
      "qaChecks": ["brand-voice", "readability", "fact-check", "email-compliance"],
      "approvalScope": ["send"],
      "complianceElements": ["unsubscribe", "physical-address", "sender-identity"]
    },
    "email-sequence": {
      "description": "Multi-step automated email journey",
      "ownerAgent": "lifecycle-email",
      "draftSkill": "email-sequence",
      "qaChecks": ["brand-voice", "readability", "fact-check", "email-compliance", "sequence-arc"],
      "approvalScope": ["send"],
      "complianceElements": ["unsubscribe", "physical-address", "sender-identity"]
    },
    "social-batch": {
      "description": "Coordinated batch of platform-native social posts",
      "ownerAgent": "social-media-manager",
      "draftSkill": "social-content-batching",
      "qaChecks": ["brand-voice", "readability", "fact-check", "platform-limits", "disclosure"],
      "approvalScope": ["publish", "schedule"]
    },
    "ad-campaign": {
      "description": "Paid media campaign with copy variants and spend plan",
      "ownerAgent": "paid-ads-specialist",
      "draftSkill": "ad-copy-variants",
      "qaChecks": ["brand-voice", "readability", "fact-check", "platform-policy", "message-match"],
      "approvalScope": ["spend", "publish"],
      "spendGovernance": {
        "killCriteriaRequired": true,
        "pacingCheck": "daily",
        "scaleUpRequiresApproval": true
      }
    },
    "landing-page": {
      "description": "Conversion-focused page copy from hero to final CTA",
      "ownerAgent": "copywriter",
      "draftSkill": "landing-page-copy",
      "qaChecks": ["brand-voice", "readability", "fact-check", "seo", "message-match"],
      "approvalScope": ["publish"]
    },
    "press-release": {
      "description": "Earned-media release with verified quotes and embargo terms",
      "ownerAgent": "pr-outreach",
      "draftSkill": null,
      "qaChecks": ["brand-voice", "fact-check", "quote-verification", "inverted-pyramid"],
      "approvalScope": ["send", "publish"],
      "embargoIntegrity": true
    },
    "video-script": {
      "description": "Production-ready script for short- or long-form video",
      "ownerAgent": "video-script-writer",
      "draftSkill": null,
      "qaChecks": ["brand-voice", "readability", "fact-check", "hook-payoff"],
      "approvalScope": ["publish"]
    }
  },
  "calendar": {
    "file": "content-calendar.json",
    "leadTimes": {
      "draftToQaDays": 3,
      "qaToApprovalDays": 2,
      "approvalToPublishDays": 2
    },
    "cadenceDefaults": {
      "blog":   { "perWeek": 2, "maxPerDay": 1 },
      "email":  { "perWeek": 1, "maxPerDay": 1 },
      "social": { "perWeek": 5, "maxPerDay": 2 }
    },
    "staleStatusDays": 10
  },
  "measurement": {
    "utmRequired": true,
    "utmCampaignPattern": "[cycle]-[campaign-slug]",
    "utmContentPattern": "[campaign]-[platform]-[test]-[variable]-[variant]",
    "baselineRequired": true,
    "reportSchedule": ["launch+7d", "launch+30d"],
    "doubleCountingAudit": "monthly"
  },
  "compliance": {
    "regulatedTopics": ["health", "finance", "legal", "employment", "housing"],
    "legalReviewTriggers": [
      "regulated topics",
      "named-competitor comparisons",
      "sweepstakes or contests",
      "testimonials and endorsements",
      "personal data collection"
    ],
    "disclosureRules": ["Sponsored and affiliate content labeled per FTC guidance"]
  },
  "campaignCadence": {
    "cycleWeeks": 6,
    "structure": {
      "weeks-1-2": "research & strategy (brief, personas, keywords, competitive)",
      "weeks-3-4": "production & editorial QA (drafts through the bounded loop)",
      "week-5": "approvals & launch prep (approval gate, scheduling, tracking QA)",
      "week-6": "launch & measurement (go-live, monitoring, wrap report)"
    }
  },
  "orchestration": {
    "enabled": true,
    "maxConcurrent": 3,
    "phases": {
      "brand-sync": {
        "depends": [],
        "resources": ["filesystem:brand"],
        "blocking": false,
        "description": "Drift check vs brand-guidelines.json (conditional, if lockfile exists)"
      },
      "brief-intake": {
        "depends": ["brand-sync"],
        "resources": ["filesystem:brief"],
        "blocking": true,
        "description": "Structured interview producing campaign-brief.json"
      },
      "brand-voice-lock": {
        "depends": ["brief-intake"],
        "resources": ["filesystem:brand"],
        "blocking": true,
        "description": "Create or refresh brand-guidelines.json — no drafting without a lockfile"
      },
      "strategy-gate": {
        "depends": ["brand-voice-lock"],
        "resources": [],
        "blocking": true,
        "humanGate": true,
        "description": "Human approves objective, audience, channels, and budget before production"
      },
      "calendar": {
        "depends": ["strategy-gate"],
        "resources": ["filesystem:calendar"],
        "blocking": true,
        "description": "Generate and validate content-calendar.json"
      },
      "drafts": {
        "depends": ["calendar"],
        "resources": ["filesystem:content"],
        "blocking": true,
        "perAsset": true,
        "description": "Channel specialists draft every asset in the plan (parallel lanes)"
      },
      "editorial-qa": {
        "depends": ["drafts"],
        "resources": ["filesystem:content"],
        "blocking": true,
        "perAsset": true,
        "description": "Brand voice + readability + fact-check loop, max revisions bounded"
      },
      "channel-checks": {
        "depends": ["drafts"],
        "resources": [],
        "blocking": false,
        "perAsset": true,
        "description": "SEO checklist and platform-limit checks (advisory)"
      },
      "approval-gate": {
        "depends": ["editorial-qa", "channel-checks"],
        "resources": [],
        "blocking": true,
        "humanGate": true,
        "description": "Per-asset human sign-off — nothing publishes, sends, or spends without it"
      },
      "report": {
        "depends": ["approval-gate"],
        "resources": ["filesystem:report"],
        "blocking": true,
        "description": "campaign-report.md with measurement plan and QA evidence"
      }
    },
    "reporting": {
      "showStreamingResults": true,
      "showBatchSummary": true,
      "showSpeedupEstimate": true,
      "includeTimeline": true
    }
  },
  "reporting": {
    "outputDir": ".claude/campaigns",
    "campaignReportFile": "campaign-report.md",
    "qaReportFile": "editorial-qa-report.md",
    "approvalPackageFile": "approval-package.md",
    "includeQaEvidence": true
  }
}
