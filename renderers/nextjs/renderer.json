{
  "name": "nextjs",
  "language": "react",
  "detect": {
    "configFiles": ["next.config.*"],
    "dependencies": ["next"],
    "priority": 20
  },
  "template": "templates/nextjs",
  "component": {
    "ext": ".tsx",
    "dir": "src/components",
    "pageRouting": "app-router"
  },
  "test": {
    "runner": "vitest",
    "library": "@testing-library/react"
  },
  "converter": "figma-react-converter",
  "commands": {
    "dev": "pnpm dev",
    "build": "pnpm build",
    "test": "pnpm vitest run"
  },
  "capabilities": {
    "islands": false,
    "ssr": true,
    "darkMode": true
  }
}
