{
  "name": "sveltekit",
  "language": "svelte",
  "detect": {
    "configFiles": ["svelte.config.*"],
    "dependencies": ["@sveltejs/kit"],
    "priority": 15
  },
  "template": "templates/sveltekit",
  "component": {
    "ext": ".svelte",
    "dir": "src/lib/components",
    "pageRouting": "file-based"
  },
  "test": {
    "runner": "vitest",
    "library": "@testing-library/svelte"
  },
  "converter": "svelte-converter",
  "commands": {
    "dev": "pnpm dev",
    "build": "pnpm build",
    "test": "pnpm vitest run"
  },
  "capabilities": {
    "islands": false,
    "ssr": true,
    "darkMode": true
  }
}
