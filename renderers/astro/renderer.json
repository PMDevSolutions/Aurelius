{
  "name": "astro",
  "language": "react",
  "detect": {
    "configFiles": ["astro.config.*"],
    "dependencies": ["astro"],
    "priority": 10
  },
  "template": "templates/astro",
  "component": {
    "ext": ".astro",
    "islandExt": ".tsx",
    "dir": "src/components",
    "pageRouting": "file-based"
  },
  "test": {
    "runner": "vitest",
    "library": "@testing-library/react",
    "containerApi": true
  },
  "converter": "astro-converter",
  "commands": {
    "dev": "pnpm dev",
    "build": "pnpm build",
    "test": "pnpm vitest run"
  },
  "capabilities": {
    "islands": true,
    "ssr": true,
    "darkMode": true
  }
}
