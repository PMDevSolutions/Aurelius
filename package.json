{
  "name": "maecenas",
  "version": "2.0.0",
  "description": "Claude Code-integrated marketing framework with specialized agents, skills, and a brief-to-publish-ready campaign pipeline",
  "private": true,
  "type": "module",
  "scripts": {
    "release": "commit-and-tag-version",
    "release:minor": "commit-and-tag-version --release-as minor",
    "release:major": "commit-and-tag-version --release-as major",
    "release:patch": "commit-and-tag-version --release-as patch",
    "release:dry": "commit-and-tag-version --dry-run",
    "release:first": "commit-and-tag-version --first-release",
    "test": "vitest run scripts/__tests__",
    "verify": "bash scripts/verify-all.sh",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/PMDevSolutions/Marketing.git"
  },
  "keywords": [
    "claude-code",
    "marketing",
    "campaign-pipeline",
    "brand-voice",
    "content"
  ],
  "author": "PAMulligan",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "ajv": "^8.20.0",
    "commit-and-tag-version": "^12.7.1",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "semver": "^7.8.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.2"
  },
  "pnpm": {
    "overrides": {
      "qs": "^6.15.2"
    }
  }
}
