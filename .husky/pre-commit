# Pre-commit hook: lint content against the brand lockfile if one exists
if [ -f "scripts/brand-voice-lint.js" ] && [ -f "brand-guidelines.json" ] && [ -d "content" ]; then
  node scripts/brand-voice-lint.js content/
fi

# Pre-commit hook: flag drift between documented agent/skill counts and disk
if [ -f "scripts/check-doc-counts.sh" ]; then
  bash scripts/check-doc-counts.sh
fi
